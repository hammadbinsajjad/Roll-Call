GITHUB_TOKEN=
LINEAR_TOKEN=
# LLM config (litellm). Set one key fitting the model you point at.
LLM_API_KEY=
# OPENAI_API_KEY=  # still accepted as fallback
LLM_BASE_URL=
# provider-prefixed model, e.g. openrouter/google/gemma-3-27b-it or openai/gemma-3-27b-it
LLM_MODEL=
#MongoDB connection string
MONGO_DB_CONNECTION_STRING=
# Backend /embed endpoint (RAG upload). Optional — pipeline skips embedding when unset.
BACKEND_EMBED_URL=
SERVICE_TOKEN=
# --- Sentry (agent tracing + errors). Unset DSN = Sentry stays a no-op ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
